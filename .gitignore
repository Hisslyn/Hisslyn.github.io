# .gitignore
.DS_Store
node_modules/
.env
scripts/
perfect_folder_looks.txt
src/css/styles.css
src/css/fonts.css
src/css/fonts.min.css
src/css/components/translate.css
src/js/lang.js

# --- added 2026-07-26 (process-system scaffold) ---
# Secret hygiene. Every file in this repo is publicly served, so a leaked key is a
# published key. .env was already covered; these extend it. Nothing above this line
# was changed — see the `reproducible-build` and `gitignore-hygiene` LEDGER.md rows
# for the two pre-existing defects in the rules above, which need their own diffs.
.env.*
!.env.example
*.pem
*.key
*.log

# Compiled Python bytecode from the .claude/hooks/ scripts. Untracked today, but a
# single `git add -A` would publish it — every file in this repo is served.
__pycache__/
*.pyc

# --- added 2026-07-28 (local tool/editor noise) ---
# Per-machine Claude Code state that carries no project meaning. Untracked today;
# these rules stop a `git add -A` from publishing them. settings.local.json is
# already covered by the machine's global core.excludesFile — repeated here so the
# rule travels with the repo instead of living only on one laptop.
.claude/settings.local.json
.claude/*.local.json
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/history.jsonl

# Editor and OS byproducts. .DS_Store above already matches at any depth.
.vscode/
.idea/
*.swp
*~
Thumbs.db

# NOT ignored, deliberately: references/ holds specifications and docs/ holds the
# doc tree. Both are version-controlled artifacts. Gitignoring references/ is how
# the project this repo was forked from lost its own specifications.
#
# Also NOT ignored, deliberately: CLAUDE.md, LEDGER.md, VERIFY-LATER.md,
# loop-prompts/, and .claude/commands/ + .claude/hooks/. These are the project's
# governing documents and its enforcement scripts, not scratch notes — they are
# tracked on purpose. They ARE publicly served like everything else here, which is
# why the publication-boundary rule in CLAUDE.md forbids secrets inside them. If
# they should stop being served, the fix is structural (publish from a docs/ folder
# or a gh-pages branch), never a gitignore rule.
