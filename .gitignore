# .gitignore
.DS_Store
node_modules/
.env
scripts/
perfect_folder_looks.txt
src/css/styles.css
src/css/fonts.css
src/css/fonts.min.css
src/css/components/translate.css
src/js/lang.js

# --- added 2026-07-26 (process-system scaffold) ---
# Secret hygiene. Every file in this repo is publicly served, so a leaked key is a
# published key. .env was already covered; these extend it. Nothing above this line
# was changed — see the `reproducible-build` and `gitignore-hygiene` LEDGER.md rows
# for the two pre-existing defects in the rules above, which need their own diffs.
.env.*
!.env.example
*.pem
*.key
*.log

# Compiled Python bytecode from the .claude/hooks/ scripts. Untracked today, but a
# single `git add -A` would publish it — every file in this repo is served.
__pycache__/
*.pyc

# NOT ignored, deliberately: references/ holds specifications and docs/ holds the
# doc tree. Both are version-controlled artifacts. Gitignoring references/ is how
# the source project lost its own specifications (LESSONS.md §11).
